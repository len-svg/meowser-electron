{
  "name": "meowser",
  "version": "0.3.0",
  "description": "Meowser — 浮动浏览器（Chromium 重写版）",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:mac:arm": "electron-builder --mac --arm64",
    "build:mac:x64": "electron-builder --mac --x64",
    "release:mac": "electron-builder --mac --arm64 && echo \"\\n→ artifacts: dist/Meowser-$(node -p \\\"require('./package.json').version\\\")-arm64.{dmg,zip}\"",
    "pack": "electron-builder --dir"
  },
  "author": "Meowser",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.meowser.app",
    "productName": "Meowser",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "compression": "maximum",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.{md,log}",
      "!**/.DS_Store"
    ],
    "electronLanguages": [
      "en-US",
      "zh_CN"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "icon": "build/icon.png",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "dmg": {
      "format": "UDBZ",
      "writeUpdateInfo": false,
      "title": "Meowser ${version}",
      "icon": "build/icon.png",
      "iconSize": 96,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 200,
          "type": "file"
        },
        {
          "x": 400,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
